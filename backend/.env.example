# Keep this file as a template. Put the real key in backend/.env (ignored by Git).
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
AI_PROVIDER=openrouter
AI_API_KEY=
# Change this to any model slug available to your OpenRouter account.
AI_MODEL=openai/gpt-4o-mini
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=VLearn Tutor
