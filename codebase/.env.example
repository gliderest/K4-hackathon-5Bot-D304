APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# AI provider: local, openai, openrouter, shopaikey hoặc openai_compatible
AI_PROVIDER=local
AI_MODEL=your-model-name
AI_API_KEY=
# OpenAI de trong. OpenRouter/ShopAIKey co the de rong de app tu dien base URL mac dinh.
# Provider custom/openai_compatible thi dien endpoint OpenAI-compatible, vi du https://api.shopaikey.com/v1
AI_BASE_URL=
SYSTEM_PROMPT_PATH=./prompts/system-prompt.md
AGENT_MAX_TOKENS=256

# Vi du ShopAIKey:
# AI_PROVIDER=shopaikey
# AI_MODEL=gpt-4o
# AI_API_KEY=your-shopaikey-api-key
# AI_BASE_URL=https://api.shopaikey.com/v1

# Embedding dùng key riêng. Nếu để trống EMBEDDING_PROVIDER/EMBEDDING_API_KEY,
# app tự fallback sang keyword search local thay vì gọi nhầm OpenRouter.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Nếu ShopAIKey hỗ trợ endpoint /embeddings và bạn muốn dùng cùng key:
# EMBEDDING_PROVIDER=shopaikey
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.shopaikey.com/v1

# Web search fallback. Tool search_web chỉ chạy khi học liệu và ngữ cảnh chat không có kết quả.
# Tạo API key tại https://tavily.com và không commit key thật.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12
# Nếu điểm RAG nội bộ cao nhất thấp hơn ngưỡng này, search_web sẽ được gọi.
WEB_SEARCH_FALLBACK_MIN_SCORE=0.8

# Nguồn học liệu local. Không commit data pack.
COURSE_DATA_ROOT=./data/vlearn-pack
SLIDES_DIR=./data/vlearn-pack/slides
TRANSCRIPTS_DIR=./data/vlearn-pack/transcript

# RAG
VECTOR_STORE_DIR=./data/vector_store
CHUNKS_DIR=./data/processed/chunks
RAG_TOP_K=6
RAG_MIN_SCORE=0.18

# Long-term memory; có thể đổi sang PostgreSQL khi deploy.
DATABASE_URL=sqlite+aiosqlite:///./storage/vlearn.db

# Tài liệu do học viên upload, tách index theo learner_id.
USER_UPLOAD_DIR=./data/user_uploads
MAX_UPLOAD_MB=20
