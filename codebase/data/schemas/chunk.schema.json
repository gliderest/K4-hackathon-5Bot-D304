{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VLearnSourceChunk",
  "type": "object",
  "required": [
    "chunk_id",
    "text",
    "course_id",
    "lesson_id",
    "title",
    "source_type",
    "source_file"
  ],
  "properties": {
    "chunk_id": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "course_id": { "type": "string" },
    "lesson_id": { "type": "string" },
    "title": { "type": "string" },
    "source_type": {
      "enum": ["slide", "transcript", "user_upload"]
    },
    "source_file": { "type": "string" },
    "page": { "type": ["integer", "null"], "minimum": 1 },
    "segment_id": { "type": ["string", "null"] },
    "owner_learner_id": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_type": { "const": "slide" } }
      },
      "then": { "required": ["page"] }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "transcript" } }
      },
      "then": { "required": ["segment_id"] }
    },
    {
      "if": {
        "properties": { "source_type": { "const": "user_upload" } }
      },
      "then": { "required": ["owner_learner_id"] }
    }
  ]
}

